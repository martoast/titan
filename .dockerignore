# Build context trimming for the root (Laravel app) image.
# NOTE: the biosignal service builds from ./biosignal (its own context + .dockerignore),
# so excluding biosignal/ here only keeps the Python service OUT of the Laravel image.
.git
.github
.gitignore
node_modules
vendor
public/build
public/hot
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
biosignal
tests
.env
.env.*
!.env.production.example
*.sqlite
.DS_Store
.idea
.vscode
docker-compose.prod.yml
DEPLOY.md
