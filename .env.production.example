# ──────────────────────────────────────────────────────────────────────────────
# Titan — self-hosted production env.  Copy to `.env` and fill the REQUIRED values.
#   cp .env.production.example .env
# Lines marked «REQUIRED» must be set. The rest have working defaults for the
# docker-compose.prod.yml stack (service hostnames are the compose service names).
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME=Titan
APP_ENV=production
APP_KEY=                                   # «REQUIRED» → docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false

# Your public origin. APP_URL must match how the band/browser reaches you.
APP_URL=https://titan.example.com          # «REQUIRED» (use http://SERVER_IP if no domain yet)
APP_DOMAIN=titan.example.com               # Caddy TLS host. Real domain → auto-HTTPS. Use ":80" for plain HTTP on a bare IP.

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database (MySQL service) ──────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=titan
DB_USERNAME=titan
DB_PASSWORD=                               # «REQUIRED» → openssl rand -hex 24

# ── Redis (queue + cache + sessions) ──────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# ── Biosignal service (internal) ──────────────────────────────────────────────
BIOSIGNAL_URL=http://biosignal:8000
BIOSIGNAL_TOKEN=                           # «REQUIRED» shared secret → openssl rand -hex 32  (same value used by the biosignal container)
BIOSIGNAL_ALGO_VERSION=v1
BIOSIGNAL_TIMEOUT=60

# ── Raw waveform store (MinIO → the `raw` disk) ───────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=                          # «REQUIRED» → openssl rand -hex 12
MINIO_SECRET_KEY=                          # «REQUIRED» → openssl rand -hex 24
MINIO_REGION=us-east-1
MINIO_BUCKET=titan-raw

# ── The coach's brain (OpenAI-compatible) ─────────────────────────────────────
OPENAI_API_KEY=                            # «REQUIRED for the coach» — your LLM provider key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# ── Dream-physique image generation (edits the user's real photo) ─────────────
# Uses the OPENAI_API_KEY above. IMPORTANT: that key's OpenAI ORG MUST BE VERIFIED
# (platform.openai.com → Settings → Organization → Verify Organization) — otherwise
# `moderation: low` is ignored and shirtless physique edits get blocked as "sexual".
PHYSIQUE_IMAGE_PROVIDER=openai             # 'openai' (gpt-image-2) or 'gemini' (Nano Banana, refuses real-person edits)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT=180

# ── Web Push (PWA notifications: briefings, "your band is live", nudges) ───────
# Generate a keypair: docker compose run --rm app php artisan webpush:vapid   (or any VAPID generator)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Coach grounding (live food macros / web search) — optional ────────────────
SERPAPI_KEY=
SCRAPERAPI_KEY=

# ── Email (optional — password resets, etc.) ──────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@titan.example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
